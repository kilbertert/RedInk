# RedInk 环境变量模板
# 复制为 .env 并填写真实 key。.env 在 .gitignore,不会进入仓库。
# 优先级: 环境变量 > YAML 中同名字段 > 启动报错

# ─── psydo.top(皮皮虾AI)图片生成 ───
# 推荐用法: 在 image_providers.yaml 里把 psydo_image.api_key 留空,
# 然后在这里填真值。YAML 与 .env 同名时,env 覆盖 yaml。
PSYDO_API_KEY=
PSYDO_BASE_URL=https://api.psydo.top
PSYDO_MODEL=gpt-image-2-firefly

# ─── 文本生成(可选)───
# claude_local 走本地 CLIPROXYAPI(127.0.0.1:8317),用作 Anthropic 兼容中转。
# model id 走 CLIPROXYAPI 在 /v1/models 列出的 ID(minimax-m3 / gpt-5.6-sol 等)。
TEXT_CLAUDE_API_KEY=
TEXT_CLAUDE_BASE_URL=http://127.0.0.1:8317/v1
TEXT_CLAUDE_MODEL=minimax-m3